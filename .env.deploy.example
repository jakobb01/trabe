# Local SSH deployment settings. Copy to .env.deploy; it is excluded from Git.
# KEY=value only; values are read as text, never executed as shell commands.
# Exported environment variables take precedence over this file.
SSH_TARGET=containers@raspberrypi.local
SSH_PORT=22
# Optional, absolute paths. Quoted paths with spaces are supported.
# SSH_IDENTITY_FILE=/home/you/.ssh/id_ed25519
# SSH_CONFIG_FILE=/home/you/.ssh/config
