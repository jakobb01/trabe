# Initial credentials only. Daily settings and watchlist are managed in Telegram.
# Use: python3 -m trabe setup
TELEGRAM_BOT_TOKEN=
# Positive ID of your private conversation; setup pairs it securely.
TELEGRAM_CHAT_ID=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
# Optional additional news sources; enable through Telegram after access verification.
MASSIVE_API_KEY=
MARKETAUX_API_KEY=
# Optional local override. The container uses /data/stock_agent.db.
DATABASE_PATH=data/stock_agent.db
